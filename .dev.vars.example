# Cloudflare Access (OPTIONAL — kept for backward compatibility). If set, an
# Access JWT is accepted as a fallback identity source and a native session
# cookie is minted on first hit. Leave blank to require native cookie
# sessions only.
# TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=
TEAM_DOMAIN=

# REQUIRED. Shared secret used to sign all internal-trust envelopes:
#   1. Signed auth-context JWT minted at the Hono → Durable Object hop for
#      `/mcp` and `/agents/*`. Without it, those endpoints return 500 — chat
#      and the MCP server stop working.
#   2. `x-internal-system` worker-to-worker header used by the inbound email
#      → auto-draft path.
#   3. Mailbox invite tokens.
# Generate any high-entropy string. In production set via:
#   wrangler secret put INTERNAL_SECRET
INTERNAL_SECRET=dev-secret-change-me

# Public origin used to build links inside outbound auth emails (verify,
# magic link, password reset). Leave blank in dev — the worker will derive
# it from the request origin.
PUBLIC_BASE_URL=

# L4 P8 Bearer auth for external MCP connections. The wrangler feature flag
# is live, but Bearer add/rehydrate paths stay disabled until this KEK is set.
# Generate a 32-byte base64 KEK with:
#   openssl rand -base64 32
# In production set via:
#   wrangler secret put MCP_BEARER_KEK_CURRENT
MCP_BEARER_KEK_CURRENT=
# During rotation set PREVIOUS to the old CURRENT until every old blob has
# either been re-entered or can be retired.
MCP_BEARER_KEK_PREVIOUS=
MCP_BEARER_KEK_VERSION=1

# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Shared secret for internal worker-to-worker calls (e.g. inbound email →
# auto-draft). Generate any high-entropy string. In production set via
# `wrangler secret put INTERNAL_SECRET`. Without it, auto-drafts cannot bypass
# per-mailbox ACL.
INTERNAL_SECRET=dev-secret-change-me

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentic-inbox",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// POLICY_AUD / TEAM_DOMAIN are now optional. If set, the legacy
		// Cloudflare Access JWT path is accepted as a fallback (existing users
		// transparently get a native session on first request). If unset, only
		// cookie-based sessions issued by /api/v1/auth/* are honored.
		"DOMAINS": "ziikoo.com",
		"EMAIL_ADDRESSES": [],
		// Bootstrap admins: any email listed here is promoted to role=admin on
		// registration / first login. Once a user exists in D1, manage admins
		// via /api/v1/admin/users instead.
		"ADMINS": "blueyang@gmail.com",
		// Public origin used to build links inside outbound emails (magic link,
		// password reset). Falls back to the request origin if unset.
		"PUBLIC_BASE_URL": "",
		// OpenAI-compatible LLM endpoint that powers agent inference. Can be
		// a hosted gateway (e.g. CF AI Gateway compat URL), a self-hosted
		// LiteLLM proxy, or any provider exposing /v1/chat/completions and
		// /v1/models. Workers AI binding (env.AI) is still used for safety
		// models (verifyDraft / isPromptInjection).
		"LLM_BASE_URL": "https://litellm.ziikoo.com",
		// Default model id when a mailbox hasn't pinned one. Must exist on
		// the LLM_BASE_URL endpoint's /v1/models list.
		"LLM_DEFAULT_MODEL": "glm-5.1",
		// LLM_API_KEY is a secret — set via `wrangler secret put LLM_API_KEY`.
		// L4 (MCP Client integration) feature flag. String literal, not a
		// boolean — `isL4McpEnabled()` reads it as `String(env.L4_MCP_ENABLED) === "true"`.
		// Phase 6 lands the Settings UI dormant with the flag at "false";
		// the cutover commit flips it to "true".
		"L4_MCP_ENABLED": "true",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agentic-inbox-auth",
			"database_id": "4e72ae70-1ceb-49c5-8565-e5d39e0828aa",
			"migrations_dir": "migrations"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-inbox",
			"preview_bucket_name": "agentic-inbox"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			},
			{
				"name": "INVOICE_AGENT",
				"class_name": "InvoiceAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"InvoiceAgent"
			]
		}
	]
}

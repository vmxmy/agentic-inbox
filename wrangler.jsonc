{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentic-inbox",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// POLICY_AUD / TEAM_DOMAIN are now optional. If set, the legacy
		// Cloudflare Access JWT path is accepted as a fallback (existing users
		// transparently get a native session on first request). If unset, only
		// cookie-based sessions issued by /api/v1/auth/* are honored.
		"DOMAINS": "ziikoo.com",
		"EMAIL_ADDRESSES": [],
		// Bootstrap admins: any email listed here is promoted to role=admin on
		// registration / first login. Once a user exists in D1, manage admins
		// via /api/v1/admin/users instead.
		"ADMINS": "blueyang@gmail.com",
		// Public origin used to build links inside outbound emails (magic link,
		// password reset). Falls back to the request origin if unset.
		"PUBLIC_BASE_URL": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agentic-inbox-auth",
			"database_id": "REPLACE_WITH_REAL_D1_ID",
			"migrations_dir": "migrations"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-inbox",
			"preview_bucket_name": "agentic-inbox"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			},
			{
				"name": "INVOICE_AGENT",
				"class_name": "InvoiceAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"InvoiceAgent"
			]
		}
	]
}
